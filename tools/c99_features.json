      "mini": "supported",
      "kind": "valid",
      "test_ref": "crates/sema/src/tests.rs:c99_sizeof_expression_preserves_array_types_and_is_unevaluated",
      "source": "int f(void){int a[@N@];return sizeof a == @N@ * sizeof(int);}"
    },
