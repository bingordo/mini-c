grammar<'input>;
use crate::expr_lexer::ExprToken;
use crate::ast::{Expr, BinOp, UnOp};

pub Expression: Expr = <e:Comma> => e;
// Only the full expression entry point admits unparenthesized commas.
// Call arguments and initializer elements are assignment-expressions.
Comma: Expr = {
    <left:Comma> "," <right:Assign> => Expr::Comma(Box::new(left), Box::new(right)),
    Assign,
};
Assign: Expr = {
    <l:Conditional> "=" <r:Assign> => Expr::Assign(Box::new(l), Box::new(r)),
    <l:Conditional> "+=" <r:Assign> => Expr::CompoundAssign(BinOp::Add, Box::new(l), Box::new(r)),
    <l:Conditional> "-=" <r:Assign> => Expr::CompoundAssign(BinOp::Sub, Box::new(l), Box::new(r)),
    <l:Conditional> "*=" <r:Assign> => Expr::CompoundAssign(BinOp::Mul, Box::new(l), Box::new(r)),
    <l:Conditional> "/=" <r:Assign> => Expr::CompoundAssign(BinOp::Div, Box::new(l), Box::new(r)),
    <l:Conditional> "%=" <r:Assign> => Expr::CompoundAssign(BinOp::Mod, Box::new(l), Box::new(r)),
    <l:Conditional> "&=" <r:Assign> => Expr::CompoundAssign(BinOp::BitAnd, Box::new(l), Box::new(r)),
    <l:Conditional> "|=" <r:Assign> => Expr::CompoundAssign(BinOp::BitOr, Box::new(l), Box::new(r)),
    <l:Conditional> "^=" <r:Assign> => Expr::CompoundAssign(BinOp::BitXor, Box::new(l), Box::new(r)),
    <l:Conditional> "<<=" <r:Assign> => Expr::CompoundAssign(BinOp::Shl, Box::new(l), Box::new(r)),
    <l:Conditional> ">>=" <r:Assign> => Expr::CompoundAssign(BinOp::Shr, Box::new(l), Box::new(r)),
    Conditional,
};
// Conditional has lower precedence than || but higher than assignment.
// The middle operand is a full comma-expression, as required by C.
Conditional: Expr = {
    <condition:LogicalOr> "?" <yes:Comma> ":" <no:Conditional> =>
        Expr::Conditional(Box::new(condition), Box::new(yes), Box::new(no)),
    LogicalOr,
};
LogicalOr: Expr = {
    <l:LogicalOr> "||" <r:LogicalAnd> => Expr::Binary(BinOp::Or, Box::new(l), Box::new(r)),
    LogicalAnd,
};
LogicalAnd: Expr = {
    <l:LogicalAnd> "&&" <r:BitOr> => Expr::Binary(BinOp::And, Box::new(l), Box::new(r)),
    BitOr,
};
BitOr: Expr = {
    <l:BitOr> "|" <r:BitXor> => Expr::Binary(BinOp::BitOr, Box::new(l), Box::new(r)),
    BitXor,
};
BitXor: Expr = {
    <l:BitXor> "^" <r:BitAnd> => Expr::Binary(BinOp::BitXor, Box::new(l), Box::new(r)),
    BitAnd,
};
BitAnd: Expr = {
    <l:BitAnd> "&" <r:Equality> => Expr::Binary(BinOp::BitAnd, Box::new(l), Box::new(r)),
    Equality,
};
Equality: Expr = {
    <l:Equality> "==" <r:Relational> => Expr::Binary(BinOp::Eq, Box::new(l), Box::new(r)),
    <l:Equality> "!=" <r:Relational> => Expr::Binary(BinOp::Ne, Box::new(l), Box::new(r)),
    Relational,
};
Relational: Expr = {
    <l:Relational> "<" <r:Shift> => Expr::Binary(BinOp::Lt, Box::new(l), Box::new(r)),
    <l:Relational> ">" <r:Shift> => Expr::Binary(BinOp::Gt, Box::new(l), Box::new(r)),
    <l:Relational> "<=" <r:Shift> => Expr::Binary(BinOp::Le, Box::new(l), Box::new(r)),
    <l:Relational> ">=" <r:Shift> => Expr::Binary(BinOp::Ge, Box::new(l), Box::new(r)),
    Shift,
};
Shift: Expr = {
    <l:Shift> "<<" <r:Additive> => Expr::Binary(BinOp::Shl, Box::new(l), Box::new(r)),
    <l:Shift> ">>" <r:Additive> => Expr::Binary(BinOp::Shr, Box::new(l), Box::new(r)),
    Additive,
};
Additive: Expr = {
    <l:Additive> "+" <r:Multiplicative> => Expr::Binary(BinOp::Add, Box::new(l), Box::new(r)),
    <l:Additive> "-" <r:Multiplicative> => Expr::Binary(BinOp::Sub, Box::new(l), Box::new(r)),
    Multiplicative,
};
Multiplicative: Expr = {
    <l:Multiplicative> "*" <r:Unary> => Expr::Binary(BinOp::Mul, Box::new(l), Box::new(r)),
    <l:Multiplicative> "/" <r:Unary> => Expr::Binary(BinOp::Div, Box::new(l), Box::new(r)),
    <l:Multiplicative> "%" <r:Unary> => Expr::Binary(BinOp::Mod, Box::new(l), Box::new(r)),
    Unary,
};
Unary: Expr = {
    "++" <e:Unary> => Expr::Update { target: Box::new(e), increment: true, postfix: false },
    "--" <e:Unary> => Expr::Update { target: Box::new(e), increment: false, postfix: false },
    "+" <e:Unary> => Expr::Unary(UnOp::Plus, Box::new(e)),
    "-" <e:Unary> => Expr::Unary(UnOp::Neg, Box::new(e)),
    "!" <e:Unary> => Expr::Unary(UnOp::Not, Box::new(e)),
    "~" <e:Unary> => Expr::Unary(UnOp::BitNot, Box::new(e)),
    "&" <e:Unary> => Expr::Unary(UnOp::Address, Box::new(e)),
    "*" <e:Unary> => Expr::Unary(UnOp::Deref, Box::new(e)),
    Postfix,
};
Postfix: Expr = {
    <target:Postfix> "++" => Expr::Update { target: Box::new(target), increment: true, postfix: true },
    <target:Postfix> "--" => Expr::Update { target: Box::new(target), increment: false, postfix: true },
    <callee:Postfix> "(" <args:CallArgs> ")" => Expr::Call(Box::new(callee), args),
    Primary,
};
CallArgs: Vec<Expr> = {
    => vec![],
    <first:Assign> <rest:("," <Assign>)*> => {
        let mut args = vec![first];
        args.extend(rest);
        args
    },
};
Primary: Expr = {
    <n:"number"> =>? crate::integer_literal::parse_integer_expression(n).map_err(|reason| lalrpop_util::ParseError::User { error: reason }),
    <literal:"character"> =>? crate::char_literal::parse_ascii_character(literal).map(Expr::Int).map_err(|reason| lalrpop_util::ParseError::User { error: reason }),
    <n:"ident"> => Expr::Name(n.to_owned()),
    "(" <e:Comma> ")" => e,
};

extern {
    type Location = usize;
    type Error = &'static str;
    enum ExprToken<'input> {
        "number" => ExprToken::Number(<&'input str>),
        "character" => ExprToken::Character(<&'input str>),
        "ident" => ExprToken::Ident(<&'input str>),
        "invalid" => ExprToken::Invalid(<&'input str>),
        "=" => ExprToken::Assign,
        "++" => ExprToken::PlusPlus,
        "--" => ExprToken::MinusMinus,
        "+=" => ExprToken::AddAssign,
        "-=" => ExprToken::SubAssign,
        "*=" => ExprToken::MulAssign,
        "/=" => ExprToken::DivAssign,
        "%=" => ExprToken::ModAssign,
        "&=" => ExprToken::AndAssign,
        "|=" => ExprToken::OrAssign,
        "^=" => ExprToken::XorAssign,
        "<<=" => ExprToken::ShlAssign,
        ">>=" => ExprToken::ShrAssign,
        "||" => ExprToken::OrOr,
        "&&" => ExprToken::AndAnd,
        "==" => ExprToken::EqEq,
        "!=" => ExprToken::NotEq,
        "<=" => ExprToken::LessEq,
        ">=" => ExprToken::GreaterEq,
        "<" => ExprToken::Less,
        ">" => ExprToken::Greater,
        "+" => ExprToken::Plus,
        "-" => ExprToken::Minus,
        "*" => ExprToken::Star,
        "/" => ExprToken::Slash,
        "%" => ExprToken::Percent,
        "!" => ExprToken::Bang,
        "&" => ExprToken::Amp,
        "|" => ExprToken::Pipe,
        "^" => ExprToken::Caret,
        "~" => ExprToken::Tilde,
        "<<" => ExprToken::ShiftLeft,
        ">>" => ExprToken::ShiftRight,
        "(" => ExprToken::LParen,
        ")" => ExprToken::RParen,
        "," => ExprToken::Comma,
        "?" => ExprToken::Question,
        ":" => ExprToken::Colon,
    }
}
